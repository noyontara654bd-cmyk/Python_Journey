# Taking an integer input
n = int(input())

total_sum = 0
even_sum = 0

# Loop from 1 to n
for i in range(1, n + 1):
    square = i ** 2
    cube = i ** 3
    print(i, square, cube)
    
    # Add current number to total_sum
    total_sum = total_sum + i
    
    # Check if the number is even and add to even_sum
    if i % 2 == 0:
        even_sum = even_sum + i

# Print final sums after the loop ends
print("Total Sum:", total_sum)
print("Even Sum:", even_sum)
